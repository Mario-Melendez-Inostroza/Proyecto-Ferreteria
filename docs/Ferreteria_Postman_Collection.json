{
	"info": {
		"name": "Ferretería API - Gateway (localhost:8080)",
		"description": "Colección generada desde el código fuente actual del proyecto Ferretería. Todas las solicitudes entran por el API Gateway (http://localhost:8080), que reenvía al BFF vía Eureka. Flujo recomendado: 1) Auth > Register, 2) Auth > Login, 3) copiar el token de la respuesta y pegarlo después de 'Bearer ' en el header Authorization de los endpoints protegidos. Los UUID de ejemplo corresponden a datos seed reales del proyecto (productos y proveedores); los de ventas/compras/notificaciones deben reemplazarse por IDs obtenidos de las respuestas.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8080/health",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["health"]
						},
						"description": "Verifica que el BFF esté arriba (endpoint público, sin JWT)."
					}
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"usuario_demo\",\n    \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/auth/register",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "auth", "register"]
						},
						"description": "Registra un nuevo usuario (endpoint público). La contraseña debe tener mínimo 6 caracteres."
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"usuario_demo\",\n    \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/auth/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "auth", "login"]
						},
						"description": "Autentica al usuario y devuelve el token JWT (endpoint público). Copiar el campo 'token' de la respuesta y pegarlo tras 'Bearer ' en los demás endpoints."
					}
				}
			]
		},
